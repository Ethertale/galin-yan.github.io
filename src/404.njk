---
pagination:
  data: site.langs
  size: 1
  alias: lang
permalink: "{{ '/' | lp(lang) }}404.html"
pageKey: "404"
noindex: true
eleventyExcludeFromCollections: true
pageStyle: 404
---
{% extends "layouts/base.njk" %}

{% block content %}
<div class="stage page-frame">
    <div class="runner" data-runner aria-hidden="true"></div>

    <div class="container stage-inner">
        <h1 class="err-code" data-runner-target>4<span>0</span>4</h1>
        <p class="err-title">{{ t.notFound.title }}</p>
        <p class="err-sub">
            {{ t.notFound.sub }}
        </p>

        <div class="actions">
            <a href="{{ '/' | lp(lang) }}" class="btn-me"><span>{{ t.notFound.back }}</span></a>
            <a href="{{ '/projects' | lp(lang) }}" class="text-link">{{ t.notFound.projects }}</a>
        </div>
    </div>

    <span class="hud" aria-hidden="true">{{ t.notFound.hud }}</span>
</div>
{% endblock %}
