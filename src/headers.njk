---
# Cloudflare Pages response headers: https://developers.cloudflare.com/pages/configuration/headers/
# Rendered as a template so the CSP can list the live-check sites from src/_data/projects.json.
permalink: /_headers
eleventyExcludeFromCollections: true
---
{%- set liveOrigins = [] -%}
{%- for p in projects %}{% if p.liveCheck %}{% set liveOrigins = (liveOrigins.push(p.url | origin), liveOrigins) %}{% endif %}{% endfor -%}
# Generated from src/headers.njk - edit that file, not this one.
# When several rules match a path, Pages applies all of them; "! Name" removes a header set by an earlier rule.

/*
  Strict-Transport-Security: max-age=31536000; includeSubDomains
  X-Frame-Options: DENY
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: camera=(), microphone=(), geolocation=(), payment=(), usb=(), browsing-topics=()
  ! Access-Control-Allow-Origin
  Content-Security-Policy-Report-Only: default-src 'self'; script-src 'self' https://pulse.galin-yan.com; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' https://fonts.gstatic.com; img-src 'self' data: https://cdn.jsdelivr.net https://img.icons8.com https://softuni.bg {{ liveOrigins | join(' ') }}; connect-src 'self' https://pulse.galin-yan.com; object-src 'none'; base-uri 'self'; form-action 'self'; frame-ancestors 'none'

# Legacy R&D page and demo (hand-written, many CDNs, inline code). Own looser policy until the rework in 1.4.
/projects/reason-and-domination*
  ! Content-Security-Policy-Report-Only
  Content-Security-Policy-Report-Only: default-src 'self'; script-src 'self' 'unsafe-inline' https://cdn.jsdelivr.net https://code.jquery.com https://pulse.galin-yan.com; style-src 'self' 'unsafe-inline' https:; font-src 'self' https:; img-src 'self' data: https:; connect-src 'self' https://pulse.galin-yan.com; object-src 'none'; base-uri 'self'; frame-ancestors 'none'
/projects/demo/*
  ! Content-Security-Policy-Report-Only
  Content-Security-Policy-Report-Only: default-src 'self'; script-src 'self' 'unsafe-inline' https://cdn.jsdelivr.net https://code.jquery.com https://pulse.galin-yan.com; style-src 'self' 'unsafe-inline' https:; font-src 'self' https:; img-src 'self' data: https:; connect-src 'self' https://pulse.galin-yan.com; object-src 'none'; base-uri 'self'; frame-ancestors 'none'

# Caching. HTML keeps Pages' default (revalidate on every visit), so a deploy shows up immediately.
# Content-hashed or versioned URLs never change content: cache them for a year.
/img/*
  Cache-Control: public, max-age=31536000, immutable
/vendor/*
  Cache-Control: public, max-age=31536000, immutable
# Templates link these as ?v=<content hash> (the "bust" filter), so a changed file gets a new URL.
# The legacy R&D page links its CSS/JS without ?v=: those files are frozen until 1.4.
/css/*
  Cache-Control: public, max-age=31536000, immutable
/js/*
  Cache-Control: public, max-age=31536000, immutable
# Rename the file if the font ever changes (it's referenced by a fixed URL in main.css and the preload).
/fonts/*
  Cache-Control: public, max-age=31536000, immutable
# Original images (Open Graph banner, R&D screenshots) - unversioned, so a week.
/rsc/*
  Cache-Control: public, max-age=604800
