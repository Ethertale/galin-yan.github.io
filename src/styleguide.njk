---
permalink: /styleguide.html
title: "Style tile | Galin Yan"
description: "Design system draft for galin-yan.com (roadmap 1.3.0)."
noindex: true
eleventyExcludeFromCollections: true
pageStyle: styleguide
---
{% extends "layouts/base.njk" %}

{#- One component sheet, rendered once per theme (light and black). -#}
{% macro sheet(theme) %}
<div class="sg-theme sg-{{ theme }}">
    <p class="sg-hud sg-sheet-name">{{ "Daylight" if theme == "light" else "Black" }} · DORFic</p>

    <h3 class="sg-h3">Ready for the next <span class="sg-accent">run</span></h3>
    <p class="sg-body">Body copy sits on the base colour in ink. Secondary text uses muted. Red only marks
        the path: <a href="#" class="sg-link">a text link</a>, buttons, focus and the runner.</p>

    <div class="sg-row">
        <a href="#" class="sg-btn" style="--cut: 12px"><span>View projects →</span></a>
        <a href="#" class="sg-btn is-hover" style="--cut: 12px"><span>Hovered →</span></a>
        <a href="#" class="sg-link-label">Text link</a>
    </div>

    <div class="sg-row sg-nav-demo">
        <span class="sg-nav">Home</span>
        <span class="sg-nav is-active">Projects</span>
        <span class="sg-nav is-focus">About</span>
    </div>

    <label class="sg-field">
        <span class="sg-hud">Your email</span>
        <input type="email" placeholder="you@example.com" tabindex="-1">
    </label>

    <div class="sg-triple" aria-hidden="true"><i></i><i></i><i></i></div>

    <div class="sg-glass">
        <span class="sg-hud">Glass panel</span>
        <p>Translucent polycarbonate: modal, language switch, toasts.</p>
    </div>
</div>
{% endmacro %}

{#- A page hero on one of the two shortlisted textures (decision 2). -#}
{% macro hero(texture, theme, bg) %}
<figure class="sg-card sg-hero-card">
<div class="sg-hero sg-theme sg-{{ theme }}"{% if bg %} lang="bg"{% endif %}>
    <svg class="sg-hero-tex" viewBox="0 0 1200 480" preserveAspectRatio="xMidYMid slice" aria-hidden="true">
        {%- for t in (heroPoly if texture == "poly" else heroHex) %}<polygon points="{{ t.points }}" fill-opacity="{{ t.o }}"/>{% endfor %}
    </svg>
    <div class="sg-hero-body">
        <p class="sg-hud sg-stamp sg-hero-stamp"><span>Base · Kazanlak, BG</span><span>42.62° N, 25.39° E</span><span data-clock>local time</span></p>
        {%- if bg %}
        <p class="sg-hero-name sg-hero-bg">Галин Янъков</p>
        <p class="sg-hero-sub">Софтуерен инженер. Уеб, игри и инструменти, които работят бързо.</p>
        {%- else %}
        <p class="sg-hero-name">Galin Yan</p>
        <p class="sg-hero-sub">Software engineer. Web, games and tools that run fast.</p>
        {%- endif %}
        <div class="sg-triple sg-triple-short" aria-hidden="true"><i></i><i></i><i></i></div>
        <div class="sg-row"><a href="#" class="sg-btn" style="--cut: {{ chosenChamfer }}px"><span>{{ "Проекти →" if bg else "View projects →" }}</span></a></div>
    </div>
</div>
<figcaption><b>{{ "Low-poly" if texture == "poly" else "Hex" }}</b> {{ "Daylight" if theme == "light" else "Black" }}{{ ", Bulgarian (Unbounded)" if bg }}</figcaption>
</figure>
{% endmacro %}

{% block head %}
    <!-- Draft tokens, generated from src/styleguide.11tydata.js -->
    <style>
{%- for theme, tokens in palette %}
        .sg-{{ theme }} { {% for t in tokens %}--{{ t.name }}: {{ t.hex }}; {% endfor %}}
{%- endfor %}
    </style>
{% endblock %}

{% block content %}
<header class="sg-header">
    <div class="container">
        <h1 class="sg-title">Style tile</h1>
        <p class="sg-hud">v1.3.5 &nbsp;/&nbsp; Runner Vision &nbsp;/&nbsp; <span data-clock>Kazanlak</span></p>
        <p class="sg-intro">The design system on one page. Sections 01 to 07 are the approved style tile (the
            decisions are in 07); <a href="#components" class="link-arrow">08 Components</a> shows the live components
            the pages are built from.</p>
    </div>
</header>

<div class="container sg-main">

    <!-- 01 PALETTE -->
    <section class="sg-section">
        <h2 class="sg-h2"><span class="sg-index">01</span>Palette</h2>
        <p class="sg-note">Contrast is computed at build time against the base and the panel colour.
            AA needs 4.5 for normal text and 3 for large text (24px+, or 19px+ bold).</p>
        <div class="sg-palettes">
        {%- for theme, tokens in palette %}
            <div class="sg-palette sg-theme sg-{{ theme }}">
                <p class="sg-hud">{{ "Daylight" if theme == "light" else "Black" }}</p>
                {%- set base = tokens[0].hex %}{% set panel = tokens[1].hex %}
                {%- for t in tokens %}
                <div class="sg-swatch">
                    <span class="sg-chip" style="background: {{ t.hex }}"></span>
                    <span class="sg-swatch-text">
                        <b>--{{ t.name }}</b> <code>{{ t.hex }}</code><br>
                        <small>{{ t.role }}</small>
                    </span>
                    {%- if t.type == "text" %}
                    {%- set c = t.hex | contrast(base) %}
                    <span class="sg-ratio {{ 'is-pass' if c >= 4.5 else ('is-large' if c >= 3 else 'is-fail') }}"
                          title="vs panel: {{ t.hex | contrast(panel) }}">{{ c }}<small>{{ 'AA' if c >= 4.5 else ('AA large' if c >= 3 else 'fail') }}</small></span>
                    {%- endif %}
                </div>
                {%- endfor %}
            </div>
        {%- endfor %}
        </div>
        <p class="sg-note"><b>Still open (1.3.1.1):</b> <code>--red</code> must match the red printed on your business
            cards. Send me the Pantone/CMYK value from the print file (or a photo next to a white sheet) and I'll match it on screen.</p>
    </section>

    <!-- 02 TYPE -->
    <section class="sg-section">
        <h2 class="sg-h2"><span class="sg-index">02</span>Type</h2>
        <div class="sg-type">
            <div class="sg-type-row"><span class="sg-hud">Display · Good Times</span><p class="sg-display">Galin <span class="sg-accent">Yan</span></p></div>
            <div class="sg-type-row"><span class="sg-hud">H1 · Good Times</span><p class="sg-h1">Projects &amp; Works</p></div>
            <div class="sg-type-row"><span class="sg-hud">H2 · Good Times</span><p class="sg-h2-demo">Selected projects</p></div>
            <div class="sg-type-row"><span class="sg-hud">Label · Sofia Sans Condensed 600</span><p class="sg-label-demo">View project · Stack · Contact</p></div>
            <div class="sg-type-row"><span class="sg-hud">HUD · Sofia Sans Condensed 500</span><p class="sg-hud sg-hud-big">Base · Kazanlak, BG / 42.62° N, 25.39° E</p></div>
            <div class="sg-type-row"><span class="sg-hud">Body · Sofia Sans 400</span>
                <p class="sg-body sg-sofia">I'm Galin, a Java/Spring developer based in Kazanlak, Bulgaria. I build websites and web applications, from the database to the last hover state.</p></div>
        </div>

        <h3 class="sg-h3 sg-sub">Bulgarian <span class="sg-hud">decision 5</span></h3>
        <p class="sg-note">Good Times has no Cyrillic, so Bulgarian letters in a headline come from Unbounded automatically. Sofia Sans is by a Bulgarian
            studio and switches to Bulgarian letterforms when the page says <code>lang="bg"</code>: compare д, л, ж, к below.</p>
        <div class="sg-cyr">
            <div><span class="sg-hud">Headline · Good Times + Unbounded</span><p class="sg-cyr-head" style="font-family: var(--font-head)">Галин Янъков · Galin Yan</p></div>
        </div>
        <div class="sg-cyr sg-cyr-body">
            <div><span class="sg-hud">Sofia Sans · lang="bg"</span><p lang="bg" class="sg-body sg-sofia">Създавам уебсайтове и уеб приложения: дълго, лесно, жълто, книга.</p></div>
            <div><span class="sg-hud">Sofia Sans · lang="ru" (default forms)</span><p lang="ru" class="sg-body sg-sofia">Създавам уебсайтове и уеб приложения: дълго, лесно, жълто, книга.</p></div>
        </div>
    </section>

    <!-- 03 SIGNATURE ELEMENTS -->
    <section class="sg-section">
        <h2 class="sg-h2"><span class="sg-index">03</span>Signature elements</h2>

        <div class="sg-grid">
            <figure class="sg-card">
                <div class="sg-demo sg-runner-demo">
                    <span class="sg-runner" aria-hidden="true"></span>
                    <p class="sg-runner-title">Projects</p>
                    <p class="sg-runner-text">The runner sits in the gutter and turns 90° into each section title.</p>
                </div>
                <figcaption><b>1 · Runner line + notch</b> Live on the 404 since the trial. Approved, so it rolls out in 1.3.3.5.</figcaption>
            </figure>

            <figure class="sg-card">
                <div class="sg-demo sg-chamfers">
                    {%- for c in chamfers %}
                    <a href="#" class="sg-btn" style="--cut: {{ c }}px"><span>{{ c }}px</span></a>
                    {%- endfor %}
                </div>
                <figcaption><b>2 · Chamfered button</b> Top-right corner cut at 45°. Hover one to see the red sweep. <span class="sg-hud">decision 1</span></figcaption>
            </figure>

            <figure class="sg-card">
                <div class="sg-demo sg-center">
                    <div class="sg-triple" aria-hidden="true"><i></i><i></i><i></i></div>
                </div>
                <figcaption><b>3 · Triple line</b> Three parallel hairlines, the middle one red. Section divider and logo motif.</figcaption>
            </figure>

            <figure class="sg-card">
                <div class="sg-demo sg-center">
                    <div class="sg-plinth">
                        <span class="sg-hud sg-plinth-label">PRJ-02</span>
                        {% image "/rsc/imgs/projects/RCTH-Cover.png", "RCTH Stara Zagora cover", "320px", { loading: "lazy" } %}
                    </div>
                </div>
                <figcaption><b>4 · Plinth</b> Screenshots on display: bright panel, hairline, hard offset shadow, index label.</figcaption>
            </figure>

            <figure class="sg-card">
                <div class="sg-demo sg-center">
                    <p class="sg-hud sg-hud-big sg-stamp">
                        <span>Base · Kazanlak, BG</span>
                        <span>42.62° N, 25.39° E</span>
                        <span data-clock>local time</span>
                        <span>02 / 04</span>
                    </p>
                </div>
                <figcaption><b>5 · HUD stamp</b> Coordinates, live Kazanlak time and the page index.</figcaption>
            </figure>
        </div>

        <h3 class="sg-h3 sg-sub">6 · Background texture <span class="sg-hud">decision 2</span></h3>
        <div class="sg-textures">
            <figure class="sg-card"><div class="sg-tex sg-tex-grid"></div><figcaption><b>A · Grid</b> Today's page header.</figcaption></figure>
            <figure class="sg-card"><div class="sg-tex">
                <svg viewBox="0 0 1200 400" preserveAspectRatio="xMidYMid slice" aria-hidden="true">
                    {%- for t in lowPoly %}<polygon points="{{ t.points }}" fill="#141414" fill-opacity="{{ t.o }}"/>{% endfor %}
                </svg></div><figcaption><b>B · Low-poly</b> Triangulated greys, near-invisible.</figcaption></figure>
            <figure class="sg-card"><div class="sg-tex">
                <svg aria-hidden="true" width="100%" height="100%">
                    <defs><pattern id="sg-hex" width="27.71" height="48" patternUnits="userSpaceOnUse">
                        <path d="M13.86 0 L27.71 8 L27.71 24 L13.86 32 L0 24 L0 8 Z M13.86 32 L13.86 48" fill="none" stroke="#141414" stroke-opacity=".07" stroke-width="1"/>
                    </pattern></defs>
                    <rect width="100%" height="100%" fill="url(#sg-hex)"/>
                </svg></div><figcaption><b>C · Hex</b> Honeycomb hairlines.</figcaption></figure>
        </div>
    </section>

    <!-- 04 SECTION MARKERS (eyebrow replacements) -->
    <section class="sg-section">
        <h2 class="sg-h2"><span class="sg-index">04</span>Section markers</h2>
        <p class="sg-note">What replaces the eyebrow labels. The runner notch (A) is approved for desktop. The runner is
            hidden on phones, so phones need a fallback: B or D. <span class="sg-hud">decision 3</span></p>
        <div class="sg-markers">
            <figure class="sg-card">
                <div class="sg-demo sg-marker sg-marker-a"><span class="sg-runner" aria-hidden="true"></span><p class="sg-marker-title">About me</p></div>
                <figcaption><b>A · Runner notch</b> Desktop (approved).</figcaption>
            </figure>
            <figure class="sg-card">
                <div class="sg-demo sg-marker sg-phone"><p class="sg-marker-title"><span class="sg-margin-index">03</span>About me</p></div>
                <figcaption><b>B · Margin index</b> Phone width. Position data, like a page number.</figcaption>
            </figure>
            <figure class="sg-card">
                <div class="sg-demo sg-marker sg-phone"><p class="sg-marker-title">About me</p><div class="sg-triple sg-triple-short" aria-hidden="true"><i></i><i></i><i></i></div></div>
                <figcaption><b>D · Triple line</b> Phone width. Reuses signature element 3.</figcaption>
            </figure>
        </div>
    </section>

    <!-- 05 LIGHT AND BLACK -->
    <section class="sg-section">
        <h2 class="sg-h2"><span class="sg-index">05</span>Daylight and black</h2>
        <p class="sg-note">The same components with the same red. Daylight is the identity; black is the variant
            (dark mode follows in 1.7). <span class="sg-hud">decision 4</span></p>
        <div class="sg-themes">
            {{ sheet("light") }}
            {{ sheet("dark") }}
        </div>
    </section>

    <!-- 06 TEXTURE SAMPLES -->
    <section class="sg-section">
        <h2 class="sg-h2"><span class="sg-index">06</span>Texture samples</h2>
        <p class="sg-note">Low-poly and hex as a full page header, with the approved 12px button, the triple line and
            Unbounded for Bulgarian. Both use the same lighting: facets get a little darker toward the right, and the
            left side fades out behind the text. <span class="sg-hud">decision 2</span></p>
        <div class="sg-heroes">
            {{ hero("poly", "light") }}
            {{ hero("hex", "light") }}
            {{ hero("poly", "dark", true) }}
            {{ hero("hex", "dark", true) }}
        </div>
    </section>

    <!-- 07 DECISIONS -->
    <section class="sg-section">
        <h2 class="sg-h2"><span class="sg-index">07</span>Decisions</h2>
        <ol class="sg-decisions">
            <li><b>Chamfer size</b> on primary buttons and feature cards. <span class="sg-hud">Approved: 12px</span></li>
            <li><b>Background texture</b> behind headers: low-poly or hex? See 06. <span class="sg-hud">Approved: low-poly</span></li>
            <li><b>Phone section marker</b>. <span class="sg-hud">Approved: triple line (D)</span></li>
            <li><b>Black variant</b>. <span class="sg-hud">Approved</span></li>
            <li><b>Bulgarian headline font</b>. <span class="sg-hud">Approved: Unbounded, Bulgarian only; Good Times stays for English</span></li>
            <li><b>Body font</b>. <span class="sg-hud">Approved: Sofia Sans replaces Lato</span></li>
        </ol>
    </section>

    <!-- 08 COMPONENTS (live: real classes from css/main.css) -->
    <section class="sg-section" id="components">
        <h2 class="sg-h2"><span class="sg-index">08</span>Components</h2>
        <p class="sg-note">The real components from <code>css/main.css</code>, not drawings. A change there shows up here
            first, so this is the page to check before and after any style change. States that need a mouse or a
            keyboard are shown with static <code>.is-hover</code> / <code>.is-focus</code> hooks.</p>

        <div class="sg-comp">
            <div class="sg-comp-head"><h3 class="sg-h3">Buttons</h3>
                <p class="sg-note"><code>.btn-me</code> primary, <code>.btn-solid</code> for the one committing action
                    (Send), <code>.btn-ink</code> secondary, <code>.btn-sm</code> small. Disabled and busy come from
                    <code>disabled</code> / <code>aria-busy</code>, so screen readers hear the same state.</p></div>
            <div class="sg-comp-demo">
                <div class="sg-row">
                    <a href="#" class="btn-me"><span>View projects →</span></a>
                    <a href="#" class="btn-me is-hover"><span>Hovered →</span></a>
                    <button type="button" class="btn-me btn-solid"><span>Send message</span></button>
                    <button type="button" class="btn-me btn-solid is-hover"><span>Hovered</span></button>
                </div>
                <div class="sg-row">
                    <a href="#" class="btn-me btn-ink"><span>Download CV</span></a>
                    <a href="#" class="btn-me btn-sm"><span>Open project →</span></a>
                    <button type="button" class="btn-me btn-solid" disabled><span>Disabled</span></button>
                    <button type="button" class="btn-me btn-solid" aria-busy="true"><span>Sending…</span></button>
                </div>
                <div class="sg-row">
                    <a href="#" class="link-arrow">Text link</a>
                    <a href="#" class="link-arrow is-hover">Hovered</a>
                    <a href="#" class="link-arrow link-arrow-lg">View all projects</a>
                    <button type="button" class="btn-chip">Copy</button>
                    <button type="button" class="btn-chip is-hover">Copy</button>
                </div>
            </div>
        </div>

        <div class="sg-comp">
            <div class="sg-comp-head"><h3 class="sg-h3">Cards</h3>
                <p class="sg-note"><code>.card-me</code>: a 12px chamfer, the red top edge turning down the cut, and a
                    hard offset shadow that grows as the card lifts. Project card (thumb, title, text, link) and service
                    card (no thumb).</p></div>
            <div class="sg-comp-demo sg-cards">
                <a href="#" class="card-me">
                    <div class="card-face">
                        <div class="card-thumb">{% image "/rsc/imgs/projects/RCTH-Cover.png", "", "320px", { loading: "lazy" } %}</div>
                        <div class="card-body">
                            <h4 class="card-title">Project card</h4>
                            <span class="badge-me badge-live">Live</span>
                            <p class="card-text">Short summary of what was built and for whom.</p>
                            <span class="link-arrow card-foot">View project</span>
                        </div>
                    </div>
                </a>
                <a href="#" class="card-me is-hover">
                    <div class="card-face">
                        <div class="card-thumb">{% image "/rsc/imgs/projects/RCTH-Cover.png", "", "320px", { loading: "lazy" } %}</div>
                        <div class="card-body">
                            <h4 class="card-title">Hovered</h4>
                            <p class="card-text">Lifts 3px up and left; the hairline frame turns red.</p>
                            <span class="link-arrow card-foot">View project</span>
                        </div>
                    </div>
                </a>
                <a href="#" class="card-me">
                    <div class="card-face">
                        <div class="card-body">
                            <span class="badge-me">Service</span>
                            <h4 class="card-title">Service card</h4>
                            <p class="card-text">Websites for small businesses: fast, bilingual, easy to update. No thumb,
                                same frame.</p>
                            <span class="link-arrow card-foot">Ask about it</span>
                        </div>
                    </div>
                </a>
            </div>
        </div>

        <div class="sg-comp">
            <div class="sg-comp-head"><h3 class="sg-h3">Tags and badges</h3>
                <p class="sg-note"><code>.tag</code> names a thing (a skill, a stack item). <code>.badge-me</code> flags a
                    state, with a 6px chamfer. Red badges use <code>--red-text</code> so small white text keeps 4.5:1.</p></div>
            <div class="sg-comp-demo">
                <div class="tags">
                    <span class="tag"><img src="https://cdn.jsdelivr.net/gh/devicons/devicon@2.18.0/icons/java/java-plain.svg" alt="" />Java</span>
                    <span class="tag">Spring</span>
                    <span class="tag">Eleventy</span>
                    <span class="tag tag-ink">Featured</span>
                </div>
                <div class="sg-row">
                    <span class="badge-me">Client</span>
                    <span class="badge-me badge-red">New</span>
                    <span class="badge-me badge-live">Live</span>
                </div>
            </div>
        </div>

        <div class="sg-comp">
            <div class="sg-comp-head"><h3 class="sg-h3">Form fields</h3>
                <p class="sg-note">Default, focus, error, accepted, disabled. The error state comes from
                    <code>aria-invalid="true"</code> (the red corner flag plus a message), so it is announced, not only
                    coloured. Success stays ink: green is not in the palette.</p></div>
            <div class="sg-comp-demo sg-fields">
                <div class="field-group">
                    <label class="field-label" for="sg-f1">Default</label>
                    <input class="field-input" id="sg-f1" type="text" placeholder="Your full name" />
                    <span class="field-hint">Hint text sits under the field.</span>
                </div>
                <div class="field-group">
                    <label class="field-label" for="sg-f2">Focus</label>
                    <input class="field-input is-focus" id="sg-f2" type="text" value="Galin" />
                </div>
                <div class="field-group">
                    <label class="field-label" for="sg-f3">Error</label>
                    <input class="field-input" id="sg-f3" type="email" value="galin@" aria-invalid="true" aria-describedby="sg-f3-msg" />
                    <span class="field-msg" id="sg-f3-msg">Enter an email like you@example.com</span>
                </div>
                <div class="field-group">
                    <label class="field-label" for="sg-f4">Accepted</label>
                    <input class="field-input is-valid" id="sg-f4" type="email" value="you@example.com" aria-describedby="sg-f4-msg" />
                    <span class="field-msg is-ok" id="sg-f4-msg">Looks good</span>
                </div>
                <div class="field-group">
                    <label class="field-label" for="sg-f5">Disabled</label>
                    <input class="field-input" id="sg-f5" type="text" value="Not editable" disabled />
                </div>
                <div class="field-group">
                    <label class="field-label" for="sg-f6">Message</label>
                    <textarea class="field-input" id="sg-f6" rows="3" placeholder="Write your message here"></textarea>
                </div>
            </div>
        </div>

        <div class="sg-comp">
            <div class="sg-comp-head"><h3 class="sg-h3">Panels, plinth and notices</h3>
                <p class="sg-note"><code>.panel-me</code> is the lit surface with the red top edge. <code>.plinth</code>
                    puts a screenshot on display (optional <code>data-label</code>). <code>.notice</code> carries form
                    notes and results.</p></div>
            <div class="sg-comp-demo sg-panels">
                <div class="panel-me sg-panel-demo"><p class="card-text">Panel: contact sidebar, the form, the profile, the project popup.</p></div>
                <div class="plinth" data-label="PRJ-02">{% image "/rsc/imgs/projects/RCTH-Cover.png", "RCTH Stara Zagora cover", "320px", { loading: "lazy" } %}</div>
                <div class="sg-notices">
                    <p class="notice"><strong>Note:</strong> neutral information, like how the form works.</p>
                    <p class="notice notice-ok"><strong>Sent.</strong> Thanks, I'll reply within two working days.</p>
                    <p class="notice notice-error"><strong>Not sent.</strong> Something went wrong, so your mail app will open instead.</p>
                </div>
            </div>
        </div>
    </section>

</div>
{% endblock %}
