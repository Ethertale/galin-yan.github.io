---
pagination:
  data: site.langs
  size: 1
  addAllPagesToCollections: true   # default is the first page only, which left pages out of the sitemap
  alias: lang
permalink: "{{ '/projects' | lp(lang) }}.html"
pageKey: projects
pageStyle: projects
scripts:
  - /js/projects.js
  - /js/site-status.js
---
{% extends "layouts/base.njk" %}

{% block content %}
<!-- PAGE HEADER -->
<div class="page-header page-frame">
    <div class="runner" data-runner aria-hidden="true"></div>

    <div class="container page-header-inner">
        <h1 class="page-title" data-runner-target>{{ t.projects.titleHtml | safe }}</h1>
        <p class="page-sub">{{ t.projects.sub }}</p>
    </div>
</div>

<!-- PROJECTS GRID -->
<div class="projects-wrap">
    <div class="container">
        <!-- Filters: buttons with aria-pressed (js/projects.js). Without JS they stay hidden and every card shows. -->
        <div class="filter-bar" role="group" aria-label="{{ t.projects.filterLabel }}" hidden>
            <button class="filter-chip" type="button" data-filter="all" aria-pressed="true">{{ t.projects.all }}</button>
            {%- for key, label in home.kinds %}
            <button class="filter-chip" type="button" data-filter="{{ key }}" aria-pressed="false">{{ label }}</button>
            {%- endfor %}
            <span class="visually-hidden" role="status" id="filterStatus"></span>
        </div>

        <ul class="projects-grid">
            {%- for p in projects %}
            <li data-kind="{{ p.kind }}">
            <a class="card-me project-card" href="{{ ('/projects/' + p.slug) | lp(lang) }}">
                <div class="card-face">
                    <div class="card-thumb"{% if p.thumbStyle %} style="{{ p.thumbStyle }}"{% endif %}>
                        {% image p.cover, p.coverAlt, "(min-width: 768px) 420px, 100vw", { loading: "lazy", style: p.imgStyle } %}
                        <span class="card-open-hint" aria-hidden="true">{{ t.projects.openHint }}</span>
                    </div>
                    <div class="card-body">
                        <h2 class="card-title">{{ p.title }}</h2>
                        {%- if p.liveCheck %}
                        <small data-live-check="{{ p.url }}"></small>
                        {%- endif %}
                        <p class="card-text">{{ p.summary }}</p>
                        <div class="card-foot work-foot">
                            <span class="tag">{{ home.kinds[p.kind] }}</span>
                            <div class="tools-row" aria-hidden="true">
                                {%- for key in p.cardStack %}
                                <div class="tool-badge"><img src="{{ techs[key].icon }}" alt=""/></div>
                                {%- endfor %}
                            </div>
                        </div>
                    </div>
                </div>
            </a>
            </li>
            {%- endfor %}
        </ul>
    </div>
</div>
{% endblock %}
