---
permalink: /projects.html
title: "Galin Yan - Projects"
description: "Selected projects by Galin Yanakov - Java, Spring, JavaScript."
pageStyle: projects
scripts:
  - /js/projects-modal.js
  - /js/site-status.js
---
{% extends "layouts/base.njk" %}

{% block content %}
<!-- PAGE HEADER -->
<div class="page-header">
    <div class="page-runner"></div>

    <div class="container page-header-inner">
        <p class="section-label">Work</p>
        <h1 class="page-title">Projects &amp;<br>Works</h1>
        <p class="page-sub">Click any card to explore.</p>
    </div>
</div>

<!-- PROJECTS GRID -->
<div class="projects-wrap">
    <div class="container">
        <div class="projects-grid">
            {%- for p in projects %}
            <article class="project-card"
                     tabindex="0" role="button"
                     data-title="{{ p.title }}"
                     data-img="{{ p.cover }}"
                     data-desc="{{ p.description }}"
                     data-techs="{{ p.stack | join(',') }}"
                     data-link="{{ p.url }}">
                <div class="card-thumb"{% if p.thumbStyle %} style="{{ p.thumbStyle }}"{% endif %}>
                    <img loading="lazy"{% if p.imgStyle %} style="{{ p.imgStyle }}"{% endif %} src="{{ p.cover }}" alt="{{ p.coverAlt }}" />
                    <span class="card-open-hint">View Project →</span>
                </div>
                <div class="card-body">
                    <h4>{{ p.title }}</h4>
                    {%- if p.liveCheck %}
                    <small data-live-check="{{ p.url }}"></small>
                    {%- endif %}
                    <p>{{ p.summary }}</p>
                    <div class="tools-row" aria-hidden="true">
                        {%- for key in p.cardStack %}
                        <div class="tool-badge"><img src="{{ techs[key].icon }}" alt="{{ techs[key].label }}"/></div>
                        {%- endfor %}
                    </div>
                </div>
            </article>
            {%- endfor %}

        </div>
    </div>
</div>

<!-- Tech icons for the modal (read by js/projects-modal.js). JSON, never executed. -->
<script type="application/json" id="techData">{{ techs | dump | safe }}</script>

<!-- MODAL -->
<div class="modal fade" id="projectModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-lg modal-dialog-centered">
        <div class="modal-content">

            <div class="modal-header">
                <h5 class="modal-title"></h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>

            <div class="modal-body">
                <div class="row g-4">
                    <div class="col-md-5">
                        <img id="modalImage" src="" alt="project cover" />
                    </div>
                    <div class="col-md-7 d-flex flex-column">
                        <p id="modalDesc" class="modal-desc"></p>

                        <p class="modal-techs-label">Stack</p>
                        <div id="modalTechs"></div>

                        <a id="modalLink" class="btn-me mt-auto align-self-start" href="#" target="_blank" rel="noopener">
                            <span>Open Project →</span>
                        </a>
                    </div>
                </div>
            </div>

        </div>
    </div>
</div>
{% endblock %}
