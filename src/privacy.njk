---
pagination:
  data: site.langs
  size: 1
  alias: lang
permalink: "{{ '/privacy' | lp(lang) }}.html"
pageKey: privacy
pageStyle: privacy
---
{% extends "layouts/base.njk" %}

{% block content %}
<div class="page-header page-frame">
    <div class="runner" data-runner aria-hidden="true"></div>
    <div class="container page-header-inner">
        <h1 class="page-title" data-runner-target>{{ t.privacy.title }}</h1>
        <p class="page-sub">{{ t.privacy.sub }}</p>
    </div>
</div>

<div class="content-wrap">
    <div class="container">
        <article class="prose panel-me">
{% include "l10n/" + lang + "/privacy.njk" %}
        </article>
    </div>
</div>
{% endblock %}
