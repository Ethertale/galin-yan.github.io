---
permalink: /index.html
title: "Galin Yan - Software & Web Developer"
description: "Websites for businesses that are easy to find, trust and contact. Designed and built by Galin Yanakov in Kazanlak, Bulgaria."
pageStyle: index
---
{% extends "layouts/base.njk" %}

{% block head %}
    {%- set loc = site.location %}
    <script type="application/ld+json">
        {
            "@context": "https://schema.org",
            "@type": "Person",
            "name": {{ site.author | dump | safe }},
            "url": {{ site.url | dump | safe }},
            "jobTitle": {{ site.jobTitle | dump | safe }},
            "email": {{ site.email | dump | safe }},
            "address": {
                "@type": "PostalAddress",
                {%- if loc.streetAddress %}
                "streetAddress": {{ loc.streetAddress | dump | safe }},
                "postalCode": {{ loc.postalCode | dump | safe }},
                {%- endif %}
                "addressLocality": {{ loc.city | dump | safe }},
                "addressRegion": {{ loc.region | dump | safe }},
                "addressCountry": {{ loc.countryCode | dump | safe }}
            },
            "sameAs": {{ site.socials | pluck('url') | dump | safe }}
        }
    </script>
{% endblock %}

{% block content %}
<!-- HERO: the runner leads to the primary action -->
<section id="home" class="hero page-frame">
    <div class="runner" data-runner aria-hidden="true"></div>
    <div class="container">
        <div class="hero-inner" data-reveal>
            <h1>
                Galin<br>
                <span class="line-accent">Yan</span>
            </h1>

            <p class="hero-sub">
                I design and build websites that make your business easy to find, trust and contact.
                <span class="section-divider"></span>
                Clear to read, fast on every phone, made by hand in Kazanlak, Bulgaria.
            </p>

            <div class="hero-actions">
                <a href="/contacts#quote" class="btn-me btn-solid" data-runner-target><span>Get a quote →</span></a>
                <a href="#work" class="link-arrow">See my work</a>
            </div>
        </div>
    </div>

    <!-- Location stamp: city-level on purpose (~1 km). Edit site.location in src/_data/site.json
         (label "Base" -> "HQ" plus streetAddress once there is a business address). -->
    {%- set loc = site.location %}
    <span class="coord-stamp"><a href="{{ loc.mapsUrl }}" target="_blank" rel="noopener" aria-label="{{ loc.label }}: {{ loc.city }}, {{ loc.country }} (opens Google Maps)">{{ loc.label }} · {{ loc.city }}, {{ loc.countryCode }} &nbsp;/&nbsp; {{ loc.lat }}, {{ loc.lng }}</a> &nbsp;/&nbsp; <span data-clock></span></span>
</section>

<!-- SELECTED WORK: projects with "featured" in src/_data/projects.json, in that order -->
<section id="work">
    <div class="runner" data-runner aria-hidden="true"></div>
    <div class="container">

        <div class="section-header" data-reveal>
            <h2 class="section-title" data-runner-target>Selected Work</h2>
        </div>

        <div class="row g-4">
            {%- for p in projects | selectattr("featured") | sort(false, false, "featured") %}
            <div class="col-md-6 col-lg-4" data-reveal{% if loop.index0 %} data-reveal-delay="{{ loop.index0 * 100 }}"{% endif %}>
                <a class="card-me project-card" href="/projects/{{ p.slug }}">
                    <div class="card-face">
                        <div class="card-thumb"{% if p.thumbStyle %} style="{{ p.thumbStyle }}"{% endif %}>
                            {% image p.cover, "", "(min-width: 768px) 420px, 100vw", { loading: "lazy", style: p.imgStyle } %}
                        </div>
                        <div class="card-body">
                            <h3 class="card-title">{{ p.title }}</h3>
                            <p class="card-text">{{ p.summary }}</p>
                            <div class="card-foot work-foot">
                                <span class="tag">{{ home.kinds[p.kind] }}</span>
                                <span class="link-arrow">View project</span>
                            </div>
                        </div>
                    </div>
                </a>
            </div>
            {%- endfor %}
        </div>

        <p class="work-all" data-reveal><a href="/projects" class="link-arrow link-arrow-lg">All projects</a></p>
    </div>
</section>

<!-- SERVICES: copy in src/_data/home.json -->
<section id="services" class="section-off">
    <div class="runner" data-runner aria-hidden="true"></div>
    <div class="container">

        <div class="section-header" data-reveal>
            <h2 class="section-title" data-runner-target>What I Do</h2>
        </div>

        <div class="row g-4">
            {%- for s in home.services %}
            <div class="col-md-6 col-lg-3" data-reveal{% if loop.index0 %} data-reveal-delay="{{ loop.index0 * 100 }}"{% endif %}>
                <div class="panel-me service-tile">
                    <h3 class="tile-title">{{ s.title }}</h3>
                    <p class="tile-text">{{ s.text }}</p>
                </div>
            </div>
            {%- endfor %}
        </div>
    </div>
</section>

<!-- PROCESS: four steps, copy in src/_data/home.json -->
<section id="process">
    <div class="runner" data-runner aria-hidden="true"></div>
    <div class="container">

        <div class="section-header" data-reveal>
            <h2 class="section-title" data-runner-target>How It Works</h2>
        </div>

        <ol class="process">
            {%- for step in home.process %}
            <li class="process-step" data-reveal{% if loop.index0 %} data-reveal-delay="{{ loop.index0 * 100 }}"{% endif %}>
                <h3 class="tile-title">{{ step.title }}</h3>
                <p class="tile-text">{{ step.text }}</p>
            </li>
            {%- endfor %}
        </ol>
    </div>
</section>

<!-- ABOUT (short; the full story is on /about) -->
<section id="about" class="section-off">
    <div class="runner" data-runner aria-hidden="true"></div>
    <div class="container">

        <div class="section-header" data-reveal>
            <h2 class="section-title" data-runner-target>About Me</h2>
        </div>

        <p class="about-text" data-reveal>
            I'm Galin, a software and web developer focused on
            <strong>bringing your ideas to life.</strong>
            I combine technical precision with thoughtful design
            to create intuitive, modern experiences that work.
        </p>

        <div class="tags mt-4" data-reveal data-reveal-delay="100">
            <span class="tag"><img width="15" height="15" alt="" src="https://cdn.jsdelivr.net/gh/devicons/devicon@2.18.0/icons/java/java-plain.svg" />Java</span>
            <span class="tag"><img width="15" height="15" alt="" src="https://cdn.jsdelivr.net/gh/devicons/devicon@2.18.0/icons/spring/spring-original.svg" />Spring</span>
            <span class="tag"><img width="15" height="15" alt="" src="https://cdn.jsdelivr.net/gh/devicons/devicon@2.18.0/icons/thymeleaf/thymeleaf-original.svg" />Thymeleaf</span>
            <span class="tag"><img width="15" height="15" alt="" src="https://cdn.jsdelivr.net/gh/devicons/devicon@2.18.0/icons/javascript/javascript-original.svg" />JavaScript</span>
            <span class="tag"><img width="15" height="15" alt="" src="https://cdn.jsdelivr.net/gh/devicons/devicon@2.18.0/icons/html5/html5-original.svg" />HTML /<img width="15" height="15" alt="" src="https://cdn.jsdelivr.net/gh/devicons/devicon@2.18.0/icons/css3/css3-original.svg" />CSS</span>
            <span class="tag"><img width="15" height="15" alt="" src="https://cdn.jsdelivr.net/gh/devicons/devicon@2.18.0/icons/bootstrap/bootstrap-original.svg" />Bootstrap</span>
            <span class="tag"><img width="15" height="15" alt="" src="https://cdn.jsdelivr.net/gh/devicons/devicon@2.18.0/icons/mysql/mysql-original.svg" />MySQL /<img width="15" height="15" alt="" src="https://cdn.jsdelivr.net/gh/devicons/devicon@2.18.0/icons/sqlite/sqlite-original.svg" />SQLite</span>
        </div>

        <p class="mt-4" data-reveal data-reveal-delay="200"><a href="/about" class="link-arrow">More about me</a></p>
    </div>
</section>

<!-- CONTACT STRIP -->
<section id="contact">
    <div class="runner" data-runner aria-hidden="true"></div>
    <div class="container">
        <div class="contact-strip panel-me" data-reveal>

            <div class="strip-pitch">
                <h2 class="section-title" data-runner-target>Have a project in mind?</h2>
                <p class="strip-text">Tell me what you need. I'll come back with questions or a quote.</p>
                <a href="/contacts#quote" class="btn-me btn-solid"><span>Get a quote →</span></a>
            </div>

            <div class="strip-links">
                <a href="mailto:{{ site.email }}" class="contact-item">
                    <span class="contact-platform">{% icon "envelope" %} Email</span>
                    <span class="contact-value">{{ site.email }}</span>
                    <span class="contact-arrow" aria-hidden="true">→</span>
                </a>
                {%- for s in site.socials %}{% if s.onHome %}
                <a href="{{ s.url }}" target="_blank" rel="noopener" class="contact-item">
                    <span class="contact-platform">{% icon s.icon %} {{ s.name }}</span>
                    <span class="contact-value">{{ s.handle }}</span>
                    <span class="contact-arrow" aria-hidden="true">→</span>
                </a>
                {%- endif %}{% endfor %}
            </div>

        </div>
    </div>
</section>
{% endblock %}
