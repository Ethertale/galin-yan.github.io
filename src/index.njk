---
permalink: /index.html
title: "Galin Yan - Software & Web Developer"
description: "Software and web developer building clean, efficient, and scalable solutions. Based in Bulgaria."
pageStyle: index
vendorStyles:
  - https://unpkg.com/aos@2.3.4/dist/aos.css
scripts:
  - https://unpkg.com/aos@2.3.4/dist/aos.js
  - /js/home.js
---
{% extends "layouts/base.njk" %}

{% block head %}
    {%- set loc = site.location %}
    <script type="application/ld+json">
        {
            "@context": "https://schema.org",
            "@type": "Person",
            "name": {{ site.author | dump | safe }},
            "url": {{ site.url | dump | safe }},
            "jobTitle": {{ site.jobTitle | dump | safe }},
            "email": {{ site.email | dump | safe }},
            "address": {
                "@type": "PostalAddress",
                {%- if loc.streetAddress %}
                "streetAddress": {{ loc.streetAddress | dump | safe }},
                "postalCode": {{ loc.postalCode | dump | safe }},
                {%- endif %}
                "addressLocality": {{ loc.city | dump | safe }},
                "addressRegion": {{ loc.region | dump | safe }},
                "addressCountry": {{ loc.countryCode | dump | safe }}
            },
            "sameAs": {{ site.socials | pluck('url') | dump | safe }}
        }
    </script>
{% endblock %}

{% block content %}
<!-- HERO -->
<div class="hero-runner"></div>
<section id="home" class="hero">
    <div class="container">
        <div class="hero-inner" data-aos="fade-up">
<!--            <p class="hero-tag">Software &amp; Web Developer</p>-->

            <h1>
                Galin<br>
                <span class="line-accent">Yan</span>
            </h1>

            <p class="hero-sub">
                I'm Galin, a Java/Spring developer based in Kazanlak, Bulgaria.<br>
                <span class="section-divider"></span>
                I build websites and web applications.<br>
<!--                <span class="section-divider"></span>-->
<!--                Currently open to internships, junior roles, and freelancing.-->
            </p>

            <a href="/projects" class="btn-me"><span>View Projects →</span></a>
        </div>
    </div>

    <!-- Location stamp: city-level on purpose (~1 km). Edit site.location in src/_data/site.json
         (label "Base" -> "HQ" plus streetAddress once there is a business address). -->
    {%- set loc = site.location %}
    <span class="coord-stamp"><a href="{{ loc.mapsUrl }}" target="_blank" rel="noopener" aria-label="{{ loc.label }}: {{ loc.city }}, {{ loc.country }} (opens Google Maps)">{{ loc.label }} · {{ loc.city }}, {{ loc.countryCode }} &nbsp;/&nbsp; {{ loc.lat }}, {{ loc.lng }}</a></span>
</section>

<!-- PROJECTS -->
<section id="projects">
    <div class="container">

        <div class="section-header" data-aos="fade-up">
            <p class="section-label">Work</p>
            <h2 class="section-title">Selected Projects</h2>
        </div>

        <div class="row g-4">
            <div class="col-md-6 col-lg-4" data-aos="fade-up" data-aos-delay="100">
                <div class="project-card">
                    <div class="project-thumb">
                        <img style="width: 100%" src="/rsc/imgs/projects/Find-A-Dice/welcome-page.png" alt="">
                    </div>
                    <div class="project-body">
                        <h5>Find A Dice</h5>
                        <p>A social place for D&D role players to chat, form groups, host events, and manage campaigns - all in one place.</p>
                    </div>
                </div>
            </div>

                <div class="col-md-6 col-lg-4" data-aos="fade-up">
                    <div class="project-card">
                        <div class="project-thumb">
                            <img style="width: 100%" src="/rsc/imgs/projects/RnD-Cover.png" alt="">
                        </div>
                        <div class="project-body">
                            <h5>Reason & Domination</h5>
                            <p>Defense project for SoftUni - forum, roles, auth, posts and profile customization.</p>
                        </div>
                    </div>
                </div>
            <div class="col-md-6 col-lg-4 align-content-center" data-aos="fade-up" data-aos-delay="200">
                <a href="/projects" style="font-size: 2rem" class="project-link">View All Projects →</a>
            </div>

<!--            <div class="col-md-6 col-lg-4" data-aos="fade-up" data-aos-delay="200">-->
<!--                <div class="project-card">-->
<!--                    <div class="project-thumb">-->
<!--                        <span class="project-number">03</span>-->
<!--                    </div>-->
<!--                    <div class="project-body">-->
<!--                        <h5>Project Three</h5>-->
<!--                        <p>Short description of the project and what problem it solves.</p>-->
<!--                        <a href="#" class="project-link">View Project →</a>-->
<!--                    </div>-->
<!--                </div>-->
<!--            </div>-->

        </div>
    </div>
</section>

<!-- ABOUT -->
<section id="about" class="about-section">
    <div class="container">

        <div class="section-header" data-aos="fade-up">
            <p class="section-label">Background</p>
            <h2 class="section-title">About Me</h2>
        </div>

        <p class="about-text" data-aos="fade-up">
            I'm a software and web developer focused on
            <strong>bringing your ideas to life.</strong>
            I combine technical precision with thoughtful design
            to create intuitive, modern experiences that work.
        </p>

        <div class="mt-4" data-aos="fade-up" data-aos-delay="100">
            <span class="skill-tag"><img width="15px" src="https://cdn.jsdelivr.net/gh/devicons/devicon@latest/icons/java/java-plain.svg" />Java</span>
            <span class="skill-tag"><img width="15px" src="https://cdn.jsdelivr.net/gh/devicons/devicon@latest/icons/spring/spring-original.svg" />Spring</span>
            <span class="skill-tag"><img width="15px" src="https://cdn.jsdelivr.net/gh/devicons/devicon@latest/icons/thymeleaf/thymeleaf-original.svg" />Thymeleaf</span>
            <span class="skill-tag"><img width="15px" src="https://cdn.jsdelivr.net/gh/devicons/devicon@latest/icons/javascript/javascript-original.svg" />JavaScript</span>
<!--            <span class="skill-tag"><img width="15px" src="https://cdn.jsdelivr.net/gh/devicons/devicon@latest/icons/hibernate/hibernate-original.svg" />Hibernate</span>-->
            <span class="skill-tag"><img width="15px" src="https://cdn.jsdelivr.net/gh/devicons/devicon@latest/icons/html5/html5-original.svg" />HTML /<img width="15px" src="https://cdn.jsdelivr.net/gh/devicons/devicon@latest/icons/css3/css3-original.svg" />CSS</span>
            <span class="skill-tag"><img width="15px" src="https://cdn.jsdelivr.net/gh/devicons/devicon@latest/icons/bootstrap/bootstrap-original.svg" />Bootstrap</span>
            <span class="skill-tag"><img width="15px" src="https://cdn.jsdelivr.net/gh/devicons/devicon@latest/icons/mysql/mysql-original.svg" />MySQL /<img width="15px" src="https://cdn.jsdelivr.net/gh/devicons/devicon@latest/icons/sqlite/sqlite-original.svg" />SQLite</span>
        </div>

    </div>
</section>

<!-- CONTACT -->
<section id="contact">
    <div class="container">

        <div class="section-header" data-aos="fade-up">
            <p class="section-label">Get In Touch</p>
            <h2 class="section-title">Contact</h2>
        </div>

        <div class="col-lg-6" data-aos="fade-up">

            <a href="mailto:{{ site.email }}" class="contact-item">
                <span class="contact-platform"><img width="15" height="15" src="https://img.icons8.com/ios/50/new-post--v1.png" alt=""/> Email</span>
                <span class="contact-value">{{ site.email }}</span>
                <span class="contact-arrow">→</span>
            </a>
            {%- for s in site.socials %}{% if s.onHome %}

            <a href="{{ s.url }}" target="_blank" rel="noopener" class="contact-item">
                <span class="contact-platform"><img width="15" height="15" src="{{ s.iconLine }}" alt=""/> {{ s.name }}</span>
                <span class="contact-value">{{ s.handle }}</span>
                <span class="contact-arrow">→</span>
            </a>
            {%- endif %}{% endfor %}

        </div>

    </div>
</section>
{% endblock %}
