---
permalink: /sitemap.xml
eleventyExcludeFromCollections: true
---
<?xml version="1.0" encoding="UTF-8"?>
<!-- Generated by Eleventy from every page in collections.all (see src/sitemap.njk). -->
<urlset xmlns="http://www.sitemaps.org/schemas/sitemap/0.9" xmlns:xhtml="http://www.w3.org/1999/xhtml">
{%- for p in collections.all | sort(attribute="url") %}
    <url>
        <loc>{{ site.url }}{{ p.url | cleanUrl }}</loc>
        <lastmod>{{ p.date.toISOString().slice(0, 10) }}</lastmod>
        {%- if site.langs.length > 1 and p.data.pagination %}{% for l in site.langs %}
        <xhtml:link rel="alternate" hreflang="{{ l }}" href="{{ site.url }}{{ p.url | cleanUrl | altUrl(l) }}"/>
        {%- endfor %}{% endif %}
    </url>
{%- endfor %}
</urlset>
