---
permalink: /sitemap.xml
eleventyExcludeFromCollections: true
---
<?xml version="1.0" encoding="UTF-8"?>
<!-- Generated by Eleventy from every page in collections.all (see src/sitemap.njk). -->
<urlset xmlns="http://www.sitemaps.org/schemas/sitemap/0.9">
{%- for p in collections.all | sort(attribute="url") %}
    <url>
        <loc>{{ site.url }}{{ p.url | cleanUrl }}</loc>
        <lastmod>{{ p.date.toISOString().slice(0, 10) }}</lastmod>
    </url>
{%- endfor %}
{%- for url in site.extraSitemapUrls %}
    <url>
        <loc>{{ site.url }}{{ url }}</loc>
    </url>
{%- endfor %}
</urlset>
