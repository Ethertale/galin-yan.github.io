        <!-- PROFILE -->
        <div class="profile-block mb-5">
            <div class="profile-portrait">
                {% image "/rsc/imgs/other/prof-pic.jpg", "Galin Yanakov portrait", "(min-width: 768px) 220px, 100vw", {}, [440, 800] %}
            </div>
            <div class="profile-bio">
                <h1 class="profile-name">GALIN YANAKOV</h1>
                <p>Hello! I'm Galin, a web and software developer who treats programming like a game. I build backend services with
                    Java &amp; Spring and compose frontend experiences with Vue or vanilla JS. Outside of work, I enjoy gaming, creating fantasy worlds through art and stories, and constantly
                    dabble in new hobbies for fun and to learn new things.</p>
                <div class="socials">
                    {%- for s in site.socials %}
                    <a href="{{ s.url }}" target="_blank" rel="noopener" title="{{ s.name }}">
                        <img src="{{ s.icon }}" alt="{{ s.name }}" />
                    </a>
                    {%- endfor %}
                </div>
            </div>
        </div>

        <!-- WORK EXPERIENCE -->
