---
permalink: /about.html
title: "Galin Yan - About Me"
description: "Learn about Galin Yanakov - Software & Web developer."
pageStyle: about
libs: [fancybox]
scripts:
  - /js/about.js
---
{% extends "layouts/base.njk" %}

{% block content %}
<!-- PAGE HEADER -->
<div class="page-header page-frame">
    <div class="runner" data-runner aria-hidden="true"></div>
    <div class="container page-header-inner">
        <h1 class="page-title" data-runner-target>About Me</h1>
    </div>
</div>

<!-- Content: src/_data/about.json (shared with /cv) -->
<div class="content-wrap">
    <div class="container">

        <!-- PROFILE -->
        <div class="profile-block panel-me mb-5">
            <div class="profile-portrait">
                {% image "/rsc/imgs/other/prof-pic.jpg", "Galin Yanakov portrait", "(min-width: 768px) 220px, 100vw", {}, [440, 800] %}
            </div>
            <div class="profile-bio">
                <h2 class="profile-name">GALIN YANAKOV</h2>
                <p>{{ about.bio }}</p>
                <div class="profile-actions">
                    <a class="btn-me btn-sm" href="{{ '/rsc/cv/galin-yanakov-cv.pdf' | bust }}" download><span>Download CV (PDF)</span></a>
                    <div class="socials">
                        {%- for s in site.socials %}
                        <a href="{{ s.url }}" target="_blank" rel="noopener" title="{{ s.name }}">
                            <img src="{{ s.icon }}" alt="{{ s.name }}" />
                        </a>
                        {%- endfor %}
                    </div>
                </div>
            </div>
        </div>

        <!-- EXPERIENCE AND EDUCATION: one timeline, newest first -->
        <section class="data-section" aria-labelledby="tl-title">
            <div class="block-header">
                <h2 class="block-title" id="tl-title">Experience &amp; Education</h2>
            </div>

            <ol class="timeline">
                {%- for e in about.timeline %}
                <li class="tl-item" data-reveal>
                    <p class="tl-when">{{ e.start }} – {{ e.end }}</p>
                    <div class="tl-card">
                        <h3 class="entry-title">{{ e.title }}</h3>
                        <p class="tl-org">
                            {%- if e.logo %}{% image e.logo, "", "36px", { class: "edu-logo" }, [72] %}{% endif -%}
                            {{ e.org }} · {{ e.place }}
                        </p>
                        <p class="entry-desc">{{ e.text }}</p>
                        <span class="tag">{{ e.kind }}</span>
                    </div>
                </li>
                {%- endfor %}
            </ol>
        </section>

        <!-- CERTIFICATES: the diploma plus one line; every certificate opens in the lightbox -->
        {%- set d = about.diploma %}
        <section class="data-section" aria-labelledby="cert-title">
            <div class="block-header">
                <h2 class="block-title" id="cert-title">Certificates</h2>
            </div>

            <div class="cert-summary panel-me">
                <a class="cert-thumb" data-fancybox="certs" href="{% imageUrl '/rsc/imgs/certs/' + d.id + '.png', 780 %}"
                   data-caption="Diploma: {{ d.name }} ({{ d.date }})">
                    {% image "/rsc/imgs/certs/" + d.id + ".png", "SoftUni diploma: " + d.name, "120px", { loading: "lazy" }, [240] %}
                </a>
                <div class="cert-text">
                    <h3 class="entry-title">Diploma: {{ d.name }}</h3>
                    <p class="entry-desc">Software University, {{ d.date }}. Plus {{ about.certificates | length }} course certificates, from Programming Basics to Spring Advanced, MySQL and Containers and Cloud.</p>
                    <div class="cert-actions">
                        <button class="btn-me btn-sm" type="button" data-cert-open><span>View all {{ about.certificates | length + 1 }}</span></button>
                        <a class="link-arrow" href="https://softuni.bg/certificates/details/{{ d.id }}/{{ d.code }}" target="_blank" rel="noopener">Verify on softuni.bg</a>
                    </div>
                </div>
            </div>

            <details class="cert-details">
                <summary>List every course</summary>
                <ul class="cert-list">
                    {%- for c in about.certificates %}
                    <li>
                        <span class="cert-name">{{ c.name }}</span>
                        <span class="cert-date">{{ c.date }}</span>
                        <a data-fancybox="certs" href="{% imageUrl '/rsc/imgs/certs/' + c.id + '.png', 780 %}" data-caption="{{ c.name }} ({{ c.date }})"
                           aria-label="View the {{ c.name }} certificate">View</a>
                        <a href="https://softuni.bg/certificates/details/{{ c.id }}/{{ c.code }}" target="_blank" rel="noopener"
                           aria-label="Verify the {{ c.name }} certificate on softuni.bg">Verify</a>
                    </li>
                    {%- endfor %}
                </ul>
            </details>
        </section>

    </div>
</div>
{% endblock %}
