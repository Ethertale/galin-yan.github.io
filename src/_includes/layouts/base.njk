<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>{{ title }}</title>
    <meta name="description" content="{{ description }}">
{% if noindex %}
    <meta name="robots" content="noindex">
{% else %}
{% include "partials/social-meta.njk" %}
{% endif %}

    <!-- The heading font is needed on every page: fetch it with the HTML, not after the CSS. -->
    <link rel="preload" href="/fonts/good-times.woff2" as="font" type="font/woff2" crossorigin>

    <link rel="icon" href="/favicon.ico" sizes="any">
    <link rel="icon" href="/favicon.svg" type="image/svg+xml">
    <link rel="apple-touch-icon" href="/apple-touch-icon.png">

    <link href="{{ vendor.bootstrap.css }}" rel="stylesheet">
    <link href="https://fonts.googleapis.com/css2?family=Lato:ital,wght@0,100;0,300;0,400;0,700;0,900;1,100;1,300;1,400;1,700;1,900&display=swap" rel="stylesheet">
    {%- for lib in libs %}
    <link href="{{ vendor[lib].css }}" rel="stylesheet">
    {%- endfor %}
{% block head %}{% endblock %}
    <!-- Absolute paths only: Pages serves 404.html for missing URLs at any depth. -->
    <link rel="stylesheet" href="{{ '/css/main.css' | bust }}">
    <link rel="stylesheet" href="{{ ('/css/pages/' + pageStyle + '.css') | bust }}">
    <script defer src="https://pulse.galin-yan.com/p.js"></script>
</head>

<body>

{% include "partials/nav.njk" %}

{% block content %}{% endblock %}

{% include "partials/footer.njk" %}

<script src="{{ vendor.bootstrap.js }}"></script>
<script src="{{ '/js/site.js' | bust }}"></script>
{%- for lib in libs %}
<script src="{{ vendor[lib].js }}"></script>
{%- endfor %}
{%- for src in scripts %}
<script src="{{ src | bust }}"></script>
{%- endfor %}
</body>
</html>
