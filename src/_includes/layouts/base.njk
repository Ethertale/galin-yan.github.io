<!DOCTYPE html>
{% if pageKey %}{% set m = t.meta[pageKey] %}{% set title = m.title %}{% set description = m.description %}{% set ogDescription = m.ogDescription %}{% endif -%}
<html lang="{{ t.lang.code }}">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>{{ title }}</title>
    <meta name="description" content="{{ description }}">
{% if noindex %}
    <meta name="robots" content="noindex">
{% else %}
{% include "partials/social-meta.njk" %}
{% endif %}

    <!-- The page-header texture is the largest paint on most pages, and the fonts are needed everywhere:
         fetch them with the HTML, not after the CSS. -->
    <link rel="preload" href="/textures/lowpoly-v1.svg" as="image" type="image/svg+xml">
    <link rel="preload" href="/fonts/good-times.woff2" as="font" type="font/woff2" crossorigin>
    <link rel="preload" href="/fonts/sofia-sans-latin-5.3.0.woff2" as="font" type="font/woff2" crossorigin>
    <link rel="preload" href="/fonts/sofia-sans-condensed-latin-5.3.0.woff2" as="font" type="font/woff2" crossorigin>

    <link rel="icon" href="/favicon.ico" sizes="any">
    <link rel="icon" href="/favicon.svg" type="image/svg+xml">
    <link rel="apple-touch-icon" href="/apple-touch-icon.png">

    <link href="{{ vendor.bootstrap.css }}" rel="stylesheet">
    {%- for lib in libs %}
    <link href="{{ vendor[lib].css }}" rel="stylesheet">
    {%- endfor %}
{% block head %}{% endblock %}
    <!-- Absolute paths only: Pages serves 404.html for missing URLs at any depth. -->
    <link rel="stylesheet" href="{{ '/css/main.css' | bust }}">
    <link rel="stylesheet" href="{{ ('/css/pages/' + pageStyle + '.css') | bust }}">
    <script defer src="https://pulse.galin-yan.com/p.js"></script>
</head>

<body>

<a class="skip-link" href="#main">{{ t.common.skip }}</a>

{% include "partials/nav.njk" %}

<main id="main" tabindex="-1">
{% block content %}{% endblock %}
</main>

{% include "partials/footer.njk" %}

<!-- Strings the scripts show (js/site.js reads them into window.T) -->
<script type="application/json" id="t-js">{{ t.js | dump | safe }}</script>
<script src="{{ vendor.bootstrap.js }}"></script>
<script src="{{ '/js/site.js' | bust }}"></script>
<script src="{{ '/js/runner.js' | bust }}"></script>
{%- for lib in libs %}
<script src="{{ vendor[lib].js }}"></script>
{%- endfor %}
{%- for src in scripts %}
<script src="{{ src | bust }}"></script>
{%- endfor %}
</body>
</html>
