{%- set canonical = site.url + (page.url | cleanUrl) -%}
{%- set ogDesc = ogDescription or description -%}
    <meta name="author" content="{{ site.author }}">
    <meta name="robots" content="index, follow">
    <link rel="canonical" href="{{ canonical }}">
{%- if site.langs.length > 1 and pagination %}
    <!-- The same page in every language; x-default (no language match) goes to English -->
    {%- for l in site.langs %}
    <link rel="alternate" hreflang="{{ l }}" href="{{ site.url }}{{ page.url | cleanUrl | altUrl(l) }}">
    {%- endfor %}
    <link rel="alternate" hreflang="x-default" href="{{ site.url }}{{ page.url | cleanUrl | altUrl('en') }}">
{%- endif %}

    <!-- Open Graph (link previews everywhere) -->
    <meta property="og:type" content="website">
    <meta property="og:url" content="{{ canonical }}">
    <meta property="og:title" content="{{ title }}">
    <meta property="og:description" content="{{ ogDesc }}">
    <meta property="og:image" content="{{ site.url }}{{ site.ogImage }}">
    <meta property="og:image:width" content="1200">
    <meta property="og:image:height" content="630">
    <meta property="og:locale" content="{{ t.lang.locale }}">
    <meta property="og:site_name" content="{{ site.name }}">

    <!-- Twitter/X Card -->
    <meta name="twitter:card" content="summary_large_image">
    <meta name="twitter:url" content="{{ canonical }}">
    <meta name="twitter:title" content="{{ title }}">
    <meta name="twitter:description" content="{{ ogDesc }}">
    <meta name="twitter:image" content="{{ site.url }}{{ site.ogImage }}">
