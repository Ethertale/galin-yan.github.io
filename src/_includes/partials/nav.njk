<nav class="navbar navbar-expand-lg fixed-top">
    <div class="container">
        <a class="navbar-brand" href="{{ '/' | lp(lang) }}">{{ site.name }}</a>

        <button class="navbar-toggler border-0" type="button" data-bs-toggle="collapse" data-bs-target="#nav"
                aria-controls="nav" aria-expanded="false" aria-label="{{ t.common.navToggle }}">
            <span class="navbar-toggler-icon"></span>
        </button>

        <div id="nav" class="collapse navbar-collapse justify-content-end">
            <ul class="navbar-nav gap-lg-5">
                {%- for item in site.nav %}{% set u = item.url | lp(lang) %}
                <li class="nav-item"><a class="nav-link" href="{{ u }}"{% if page.url | cleanUrl == u %} aria-current="page"{% elif item.url != "/" and (page.url | cleanUrl).startsWith(u + "/") %} aria-current="true"{% endif %}>{{ t.common.nav[item.key] }}</a></li>
                {%- endfor %}
            </ul>
            {#- Language switch: on pages built in every language (they paginate), once a second language is published.
                The 404 page has no counterpart URL, so it points at the other home page. #}
            {%- if site.langs.length > 1 and pagination %}
            <p class="lang-switch">
                {%- for l in site.langs %}
                {%- if l == lang %}<span aria-current="true">{{ l10n[l].t.lang.short }}</span>
                {%- else %}<a href="{{ ('/' if pageKey == '404' else page.url | cleanUrl) | altUrl(l) }}" hreflang="{{ l }}" lang="{{ l }}" data-lang-pick="{{ l }}" aria-label="{{ l10n[l].t.lang.short }} – {{ l10n[l].t.lang.switchLabel }}">{{ l10n[l].t.lang.short }}</a>{% endif %}
                {%- if not loop.last %}<span class="lang-sep" aria-hidden="true">/</span>{% endif %}
                {%- endfor %}
            </p>
            {%- endif %}
            <a class="btn-me btn-sm nav-cta" href="{{ '/contacts' | lp(lang) }}#quote"><span>{{ t.common.cta }}</span></a>
        </div>
    </div>
</nav>
{#- Language suggestion: one hidden note per other language, written in that language. js/site.js shows
    the one matching the browser's preferred language, until the visitor picks a language or says no. #}
{%- if site.langs.length > 1 and pagination %}
{%- for l in site.langs %}{% if l != lang %}{% set lt = l10n[l].t.lang %}
<aside class="lang-suggest" lang="{{ l }}" data-lang-suggest="{{ l }}" aria-label="{{ lt.name }}" hidden>
    <p>{{ lt.suggest }}</p>
    <a class="btn-me btn-sm" href="{{ ('/' if pageKey == '404' else page.url | cleanUrl) | altUrl(l) }}" hreflang="{{ l }}" data-lang-pick="{{ l }}"><span>{{ lt.suggestGo }}</span></a>
    <button type="button" class="lang-suggest-no" data-lang-pick="{{ lang }}">{{ lt.suggestNo }}</button>
</aside>
{%- endif %}{% endfor %}
{%- endif %}
