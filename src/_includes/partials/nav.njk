<nav class="navbar navbar-expand-lg fixed-top">
    <div class="container">
        <a class="navbar-brand" href="/">{{ site.name }}</a>

        <button class="navbar-toggler border-0" type="button" data-bs-toggle="collapse" data-bs-target="#nav"
                aria-controls="nav" aria-expanded="false" aria-label="Toggle navigation">
            <span class="navbar-toggler-icon"></span>
        </button>

        <div id="nav" class="collapse navbar-collapse justify-content-end">
            <ul class="navbar-nav gap-lg-5">
                {%- for item in site.nav %}
                <li class="nav-item"><a class="nav-link" href="{{ item.url }}"{% if page.url | cleanUrl == item.url %} aria-current="page"{% elif item.url != "/" and (page.url | cleanUrl).startsWith(item.url + "/") %} aria-current="true"{% endif %}>{{ item.label }}</a></li>
                {%- endfor %}
            </ul>
            <a class="btn-me btn-sm nav-cta" href="/contacts#quote"><span>Get a quote</span></a>
        </div>
    </div>
</nav>
