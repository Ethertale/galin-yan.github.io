---
permalink: /contacts.html
title: "Galin Yan - Contact Me"
description: "Get in touch with Galin Yanakov via email, GitHub or LinkedIn."
ogDescription: "Get in touch with Galin Yanakov via email, GitHub, LinkedIn or Instagram."
pageStyle: contacts
scripts:
  - /js/contacts.js
---
{% extends "layouts/base.njk" %}

{% block content %}
<!-- PAGE HEADER -->
<div class="page-header">
    <div class="page-runner"></div>
    <div class="container page-header-inner">
        <p class="section-label">Reach Out</p>
        <h1 class="page-title">You can find<br>me here</h1>
        <p class="page-sub">Open to opportunities, collaborations, and questions.</p>
    </div>
</div>

<!-- CONTENT -->
<div class="content-wrap">
    <div class="container">
        <div class="contact-layout">

            <!-- LEFT PANEL -->
            <aside class="contact-panel">

                <div class="panel-section">
                    <p class="panel-label">Contact</p>

                    <div class="contact-item">
                        <img src="https://img.icons8.com/fluency/96/mail--v1.png" alt="email" />
                        <div>
                            <div class="contact-item-label">Email</div>
                            <div class="contact-item-value" id="emailText">{{ site.email }}</div>
                            <button class="copy-btn" id="copyEmail">Copy</button>
                        </div>
                    </div>

                    <div class="contact-item">
                        <img src="https://img.icons8.com/fluency/96/location--v1.png" alt="location" />
                        <div>
                            <div class="contact-item-label">Location</div>
                            <div class="contact-item-value">{{ site.location.city }}, {{ site.location.country }}</div>
                        </div>
                    </div>
                </div>

                <div class="panel-section">
                    <p class="panel-label">Social</p>

                    {%- for s in site.socials %}
                    <a class="social-link" href="{{ s.url }}" target="_blank" rel="noopener">
                        <img src="{{ s.icon }}" alt="{{ s.name }}" />
                        {{ s.name }}
                        <span class="social-arrow">→</span>
                    </a>
                    {%- endfor %}
                </div>

            </aside>

            <!-- FORM -->
            <div class="form-block">
                <p class="section-label">Message</p>
                <p class="form-note">
                    <strong>Note:</strong> The form will open your local mail client and prepare an email.
                    You can also directly open your mail client through the button below.
                </p>

                <form id="contactForm">
                    <div class="field-group">
                        <label class="field-label" for="name">Your name</label>
                        <input class="field-input" id="name" type="text" placeholder="Your full name" required />
                    </div>
                    <div class="field-group">
                        <label class="field-label" for="email">Your email</label>
                        <input class="field-input" id="email" type="email" placeholder="you@example.com" required />
                    </div>
                    <div class="field-group">
                        <label class="field-label" for="subject">Subject</label>
                        <input class="field-input" id="subject" type="text" placeholder="What is this about?" required />
                    </div>
                    <div class="field-group">
                        <label class="field-label" for="message">Message</label>
                        <textarea class="field-input" id="message" rows="6" placeholder="Write your message here" required></textarea>
                    </div>

                    <div class="form-actions">
                        <button class="btn-me" type="button" id="openMailClient">
                            <span>Open Mail Client →</span>
                        </button>
                        <span class="form-status" id="status"></span>
                    </div>
                </form>
            </div>

        </div>
    </div>
</div>
{% endblock %}
